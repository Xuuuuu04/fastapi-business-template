# 运行配置示例。复制为 .env 后修改；.env 不进入版本管理。完整说明见 shared/config/settings.py。

# local 本地开发，test 测试，production 生产（生产环境有额外检查，不满足会拒绝启动）
APP_ENV=local
APP_NAME=单体后端模板
# 部署的代码版本，一般写 git 提交号；生产环境必填
APP_CODE_VERSION=dev

# 数据库。本地默认 SQLite；生产必须用 PostgreSQL，例如 postgresql+psycopg://用户:密码@主机:5432/库名
APP_DATABASE_URL=sqlite+aiosqlite:///var/local.db
APP_DATABASE_POOL_SIZE=10
# 使用 deploy/compose.yaml 时设置的数据库密码
DATABASE_PASSWORD=change-this-password

# 接口文档（/docs）是否开放；跨域来源列表，例如 ["https://admin.example.com"]
APP_DOCS=true
APP_CORS=[]

# 服务密钥：用 tools.make_key --org-id 组织代码 生成，只填摘要、权限和组织范围
APP_API_KEYS=[]
# 本地开发时把匿名请求当作拥有全部权限的开发者；只在 APP_ENV=local 生效，生产环境开启会拒绝启动
APP_DEV_CALLER=true

# 请求限制
APP_MAX_BODY_BYTES=1000000
APP_MAX_INFLIGHT=200
# 耗时纯计算的每进程准入额度；取消后等真实工作结束才归还
APP_HEAVY_CONCURRENCY=4
# 正文读取的累计期限；完成输入后不限制 SSE 等长响应
APP_BODY_TIMEOUT_SECONDS=30
APP_UPLOAD_TIMEOUT_SECONDS=120
APP_REQUEST_RATE_PER_MINUTE=120
# 登录失败限流（15 分钟窗口）：同一来源地址对同一账号，以及同一账号来自所有地址
APP_LOGIN_FAILURE_LIMIT=5
APP_LOGIN_ACCOUNT_FAILURE_LIMIT=20
# 反向代理的地址（逗号分隔），只有它们传来的 X-Forwarded-For 才被当作来源地址；由 uvicorn 读取
# 例如宿主机上的 nginx 经 Docker 网关访问时写网关地址 172.17.0.1
FORWARDED_ALLOW_IPS=127.0.0.1
# 只在 HTTPS 部署确认后设置；单位秒，零表示不发送 HSTS
APP_HSTS_SECONDS=0

# 用户登录令牌：生产环境必须替换为独立的随机密钥，至少 32 个字符
APP_JWT_SECRET=local-development-only-secret-change-me
APP_JWT_ISSUER=backend-template
APP_JWT_AUDIENCE=backend-template-api
# 更换签名密钥时把旧密钥放在这里，过渡期（至少一个访问令牌有效期）后删除，例如 ["旧密钥"]
APP_JWT_PREVIOUS_SECRETS=[]
# 字段加密密钥（两步验证密钥等敏感字段加密保存用）：生产环境必须替换，每把至少 32 个字符；
# 换密钥时把新密钥放在最前面、旧密钥放在后面，例如 ["新密钥", "旧密钥"]
APP_DATA_KEYS=["local-development-only-data-key-change-me"]
# 访问令牌有效分钟数，最多 60；刷新令牌的期限由产品业务规则确定
APP_TOKEN_MINUTES=15

# 运行记录：database 保存到数据库（本地是 SQLite 文件，tools.diagnose 命令行可以直接查看；生产必须），
# memory 保存在进程内存（重启即丢，命令行看不到，只能用 /api/system/runs 诊断接口）
APP_RUN_RECORDS=database
APP_RUN_RECORD_DAYS=14

# 大模型：使用 OpenAI 兼容接口。
# 不配置地址时本地和测试使用模拟回复
APP_MODEL_BASE_URL=
APP_MODEL_API_KEY=
APP_MODEL_NAME=
APP_MODEL_TIMEOUT=60
APP_MODEL_CONCURRENCY=4
# 单次响应按解压后的实际字节限制，不无限读入内存
APP_MODEL_MAX_RESPONSE_BYTES=2000000
# 是否在运行记录中保存截断后的提示词和回复原文，排查时临时开启
APP_MODEL_KEEP_TEXT=false

# worker：同时执行的任务数、没有任务时的轮询间隔、停止时等待在途任务的秒数
APP_JOB_CONCURRENCY=4
APP_JOB_POLL_SECONDS=1
APP_JOB_SHUTDOWN_SECONDS=20
# Compose 在 worker 自己的 /tmp 中设置此路径；本机默认不创建健康文件
APP_JOB_HEALTH_FILE=
APP_JOB_HEALTH_SECONDS=60

# 内置运维默认关闭。配置与验证见deploy/backup.md；开启后需运行worker。
# 生产请填写真实Webhook（秘密，不提交）；原件前缀必须是明确模块/目录，不填不清原件。
APP_OPERATIONS={}
# 示例：{"backup":true,"retention":true,"capacity":true,"backup_root":"var/backups","backup_days":30,"batch_size":500,"original_prefixes":["report/originals"],"disk_percent":90,"database_bytes":10737418240,"pause_noncritical":true}
# 提醒另加："notifications":true,"webhook_url":"https://你的机器人地址","webhook_format":"wecom" 或 "feishu"/"generic"

# 外部接口：按名称配置地址、密钥、超时；max_response_bytes 默认 2000000
APP_REMOTES={}
# 旧系统迁移专用只读数据库；不需要时留空
APP_LEGACY_DATABASE_URL=

# 多实例应设置同一 Redis 地址；留空使用不跨进程共享的内存缓存
APP_CACHE_URL=
APP_CACHE_TIMEOUT_SECONDS=3
APP_CACHE_MAX_CONNECTIONS=50

# 文件存储：local 为本地目录，s3 为 S3 兼容存储
APP_FILE_STORAGE=local
APP_FILE_ROOT=var/files
APP_UPLOAD_ROOT=var/uploads
APP_UPLOAD_MAX_BYTES=10000000
# 只有这些路径前缀按上传大小限制请求正文，其他接口使用 APP_MAX_BODY_BYTES；
# 导入文件较大时，把 /api/v1/products/import 这类导入接口也加进来
APP_UPLOAD_PATHS=["/api/v1/files/"]
APP_UPLOAD_SUFFIXES=[".txt", ".pdf", ".png", ".jpg", ".jpeg", ".csv"]
APP_S3_BUCKET=
APP_S3_ENDPOINT=
APP_S3_REGION=
APP_S3_ACCESS_KEY=
APP_S3_SECRET_KEY=

# OTLP HTTP traces 接收地址；留空不导出。诊断网页本地默认开启，生产默认关闭
APP_OTEL_ENDPOINT=
# APP_CONSOLE=false

# 关闭不使用的业务模块；接口、后台计划一起关闭，保留表与历史数据。
# 例如关闭已生成的客户模块：["customer_contact"]；被其他模块依赖时启动会报错。
APP_DISABLED_MODULES=[]

# PostgreSQL产品RLS读取的组织设置名；默认不绑定，值只来自可信调用者。
APP_DATABASE_ORG_SETTING=
# 定时多组织；旧APP_SCHEDULE_ORG_ID仍支持，模块Schedule可指定范围。
APP_SCHEDULE_ORG_IDS=[]
APP_SCHEDULE_ORG_ID=

# 上游协议迁移完成后，将旧调用提醒升级为启动/运行错误。默认false。
APP_REMOTE_ENDPOINTS_STRICT=false
